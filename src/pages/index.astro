---
/* Orden de las secciones de la landing.
   Para reordenar, mueve la línea del componente. Nada más. */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Servicios from "../components/Servicios.astro";
import Diferenciadores from "../components/Diferenciadores.astro";
import ParaQuien from "../components/ParaQuien.astro";
import Proceso from "../components/Proceso.astro";
import Proposito from "../components/Proposito.astro";
import Producto from "../components/Producto.astro";
import Agenda from "../components/Agenda.astro";
import Footer from "../components/Footer.astro";
import Proximamente from "../components/Proximamente.astro";

/* Modo "Próximamente": se decide AL CONSTRUIR con una variable de entorno,
   no con código distinto por rama.
   · Producción: PUBLIC_PROXIMAMENTE=true en el hosting → pantalla de espera.
   · Desarrollo / local: sin la variable → landing completa.
   Para lanzar, quita la variable (o ponla en false) y vuelve a desplegar. */
const proximamente = import.meta.env.PUBLIC_PROXIMAMENTE === "true";
---

{
  proximamente ? (
    <Layout titulo="Próximamente">
      <Proximamente />
    </Layout>
  ) : (
<Layout>
  <Nav />
  <main id="contenido">
    <Hero />
    <Producto />
    <Servicios />
    <Diferenciadores />
    <ParaQuien />
    <Proceso />
    <Proposito />
    <Agenda />
  </main>
  <Footer />
</Layout>
  )
}
