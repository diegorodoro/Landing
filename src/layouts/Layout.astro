---
import "../styles/global.css";
import { site } from "../config";

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = site.descripcion } = Astro.props;
const tituloFinal = titulo ? `${titulo} · ${site.nombre}` : `${site.nombre} — ${site.claim}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Tema: se decide ANTES de pintar para que no haya destello blanco al
      cargar en modo oscuro. Bloqueante e inline a propósito (unas pocas líneas).
      1. Si la persona eligió un tema con el botón, se respeta (localStorage).
      2. Si no, se sigue la preferencia del sistema.
      theme-color tiñe la barra del navegador en móvil con el color de la página.
    -->
    <meta name="theme-color" content="#ffffff" data-tema-color />
    <script is:inline>
      (function () {
        var guardado = null;
        try {
          guardado = localStorage.getItem("tema");
        } catch (e) {}
        var oscuro = guardado
          ? guardado === "oscuro"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = oscuro ? "dark" : "light";
        if (oscuro) document.querySelector("[data-tema-color]").content = "#0c0c20";
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Precarga solo la fuente latina: es la que pinta el <h1> del hero (LCP). -->
    <link
      rel="preload"
      href="/fonts/inter-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonical} />

    <title>{tituloFinal}</title>
    <meta name="description" content={descripcion} />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- TODO: crear /public/og.jpg de 1200x630 y descomentar estas dos líneas
    <meta property="og:image" content={new URL("/og.jpg", site.url).href} />
    <meta name="twitter:image" content={new URL("/og.jpg", site.url).href} />
    -->

    <!-- Datos estructurados: ayuda a Google a entender qué es esta empresa -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: site.nombre,
        description: site.descripcion,
        url: site.url,
        email: site.email,
        areaServed: "MX",
        address: {
          "@type": "PostalAddress",
          addressCountry: "MX",
          addressRegion: "Puebla",
        },
      })}
    />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accion focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      // Anima los elementos con [data-reveal] cuando entran en pantalla.
      // Se desconecta tras animar cada uno: no queda nada escuchando scroll.
      const objetivos = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (sinMovimiento || !("IntersectionObserver" in window)) {
        objetivos.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.add("is-visible");
              observador.unobserve(entrada.target);
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
        );
        objetivos.forEach((el) => observador.observe(el));
      }
    </script>
  </body>
</html>
