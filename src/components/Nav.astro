---
import { Image } from "astro:assets";
import { site, nav, agenda } from "../config";
import logo from "../assets/brand/solotu-logo-recortado.png";
import logoBlanco from "../assets/brand/solotu-logo-blanco.png";
// Si hay URL de calendario, los botones abren el calendario.
// Si no, bajan al formulario de la sección Agenda.
const destinoCta = agenda.url || "#agenda";
const externo = Boolean(agenda.url);
---

{/*
  Barra de navegación con material tipo Liquid Glass. Es la capa funcional y la
  única superficie con cristal de la página (liquid-glass.md › checklist 2:
  "Count the custom glass surfaces. More than the few most important functional
  elements is a defect").

  El material y las etiquetas viven en global.css como variables, para que la
  barra pueda invertirse cuando pasa sobre una sección oscura.
*/}
{/* Cápsula flotante: la barra se separa de los bordes de la ventana y flota
    sobre el contenido. El header ocupa todo el ancho pero no captura clics
    (pointer-events-none); solo la cápsula los recibe.
    El CTA va a 8px del borde derecho (pr-2) y ambos son rounded-full: radios
    concéntricos, radio exterior = radio interior + margen. */}
<header id="nav" class="pointer-events-none fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-4 sm:pt-4" data-nav>
  <nav class="nav-capsula pointer-events-auto mx-auto flex max-w-5xl items-center justify-between rounded-full py-2 pr-2 pl-6">
    {/* Logotipo en dos versiones: con trazos negros para fondos claros y con
        todo en blanco para cuando la barra pasa sobre una sección oscura.
        alt="" porque el nombre accesible lo da el sr-only del enlace.
        h-8 + py-1 dan un área pulsable de 40px de alto (checklist 7). */}
    <a href="#" class="nav-marca block py-1">
      {/* En móvil un poco menor (28px) para que quepan logo, tema y CTA en 360px */}
      <span class="relative block h-7 w-[118px] sm:h-8 sm:w-[135px]">
        <Image src={logo} alt="" height={32} densities={[1, 2, 3]} class="nav-logo absolute inset-0 h-7 w-auto sm:h-8" loading="eager" />
        <Image src={logoBlanco} alt="" height={32} densities={[1, 2, 3]} class="nav-logo-claro absolute inset-0 h-7 w-auto sm:h-8" loading="eager" />
      </span>
      <span class="sr-only">{site.nombre} — inicio</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="nav-enlace block py-2 text-sm transition-colors">
              {item.texto}
            </a>
          </li>
        ))
      }
    </ul>

    {/* Única acción con fondo sólido de la barra. liquid-glass.md › Color on
        glass: "To emphasize a primary action, color the background rather than
        the symbol or label" y "Refrain from adding color to the background of
        multiple controls". py-3 da 44px de alto, el objetivo táctil de móvil. */}
    <div class="flex items-center gap-1 sm:gap-2">
      {/* Cambio de tema. Botón sin fondo (solo el CTA lleva color, ver arriba).
          · El icono muestra el modo AL QUE CAMBIA: luna en claro, sol en oscuro.
          · El aria-label describe la acción y se actualiza con el tema; por eso
            no lleva aria-pressed (combinar los dos se anuncia confuso).
          · 40×40: por encima del mínimo de escritorio y cómodo en móvil. */}
      <button
        type="button"
        class="nav-tema relative flex h-10 w-10 items-center justify-center rounded-full transition-colors"
        data-tema-boton
        aria-label="Cambiar a modo oscuro"
        title="Cambiar a modo oscuro"
      >
        <svg class="nav-tema-luna h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
        </svg>
        <svg class="nav-tema-sol absolute h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
      </button>

      <a
        href={destinoCta}
        target={externo ? "_blank" : undefined}
        rel={externo ? "noopener noreferrer" : undefined}
        class="nav-cta rounded-full px-4 py-3 text-sm font-medium whitespace-nowrap transition-all duration-200 hover:scale-105 active:scale-100 sm:px-5"
      >
        {/* Texto corto en móvil: el completo no cabe junto al logo y el tema */}
        <span class="sm:hidden">Agendar</span>
        <span class="hidden sm:inline">{agenda.cta}</span>
      </a>
    </div>
  </nav>
</header>

<script>
  /*
    Tema claro / oscuro.
    · El tema inicial ya lo puso el script del <head> (Layout.astro).
    · Al pulsar, cambia y se GUARDA: la elección de la persona manda sobre
      la del sistema en visitas futuras.
    · Si nunca eligió, sigue en vivo los cambios del sistema (p. ej. el modo
      automático de macOS al anochecer).
    · Fundido con View Transitions donde exista y no se pida menos movimiento.
  */
  const raiz = document.documentElement;
  const botonTema = document.querySelector<HTMLButtonElement>("[data-tema-boton]");
  const metaColor = document.querySelector<HTMLMetaElement>("[data-tema-color]");
  const sistemaOscuro = window.matchMedia("(prefers-color-scheme: dark)");
  const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)");

  const leerGuardado = () => {
    try {
      return localStorage.getItem("tema");
    } catch {
      return null;
    }
  };

  const pintarTema = (oscuro: boolean) => {
    raiz.dataset.theme = oscuro ? "dark" : "light";
    if (metaColor) metaColor.content = oscuro ? "#0c0c20" : "#ffffff";
    if (botonTema) {
      const accion = oscuro ? "Cambiar a modo claro" : "Cambiar a modo oscuro";
      botonTema.setAttribute("aria-label", accion);
      botonTema.title = accion;
    }
  };

  const aplicarTema = (oscuro: boolean) => {
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !menosMovimiento.matches) {
      doc.startViewTransition(() => pintarTema(oscuro));
    } else {
      pintarTema(oscuro);
    }
  };

  pintarTema(raiz.dataset.theme === "dark");

  botonTema?.addEventListener("click", () => {
    const oscuro = raiz.dataset.theme !== "dark";
    try {
      localStorage.setItem("tema", oscuro ? "oscuro" : "claro");
    } catch {}
    aplicarTema(oscuro);
  });

  sistemaOscuro.addEventListener("change", (e) => {
    if (!leerGuardado()) aplicarTema(e.matches);
  });
</script>

<script>
  /*
    Dos comportamientos:

    1. El cristal aparece al separarse del borde superior. Arriba del todo la
       barra es transparente: no hay nada debajo que reflejar.

    2. El material se adapta a lo que tiene debajo. La guía pide "sample the
       luminance beneath the surface and switch label colors between dark and
       light": sin esto, la barra clara con texto oscuro pasaría sobre las
       secciones oscuras (Producto, Agenda) y chocaría con ellas.

       En lugar de muestrear píxeles —caro en cada scroll— se observa una franja
       fina a la altura de la barra: la sección que la cruza decide el tono.
  */
  const barra = document.querySelector<HTMLElement>("[data-nav]");

  if (barra) {
    // 1. Cristal al hacer scroll
    const alternarCristal = () => barra.classList.toggle("glass", window.scrollY > 24);
    alternarCristal();
    window.addEventListener("scroll", alternarCristal, { passive: true });

    // 2. Tono según la sección que pasa por debajo
    const oscuras = document.querySelectorAll("[data-fondo-oscuro]");

    if (oscuras.length && "IntersectionObserver" in window) {
      const alto = barra.offsetHeight || 64;
      const cruzando = new Set<Element>();

      const observador = new IntersectionObserver(
        (entradas) => {
          for (const entrada of entradas) {
            if (entrada.isIntersecting) cruzando.add(entrada.target);
            else cruzando.delete(entrada.target);
          }
          barra.classList.toggle("glass-oscura", cruzando.size > 0);
        },
        // Franja de detección: desde el borde superior hasta el bajo de la
        // barra. Todo lo que quede por debajo se ignora.
        { rootMargin: `0px 0px -${Math.max(window.innerHeight - alto, 0)}px 0px` },
      );

      oscuras.forEach((s) => observador.observe(s));
    }
  }
</script>
