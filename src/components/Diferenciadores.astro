---
import { diferenciadores } from "../config";
---

<section class="bg-ink-900 py-24 text-white sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl" data-reveal>
      Por qué nosotros y no una consultora con una presentación
    </h2>

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      {
        diferenciadores.map((item, i) => (
          <div data-reveal style={`--d: ${i * 120}ms`}>
            <div class="h-px w-full bg-white/15">
              <div class="h-px w-12 bg-brand-500" />
            </div>
            <h3 class="mt-6 text-xl font-semibold tracking-tight">{item.titulo}</h3>
            <p class="mt-3 leading-relaxed text-ink-300">{item.texto}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
