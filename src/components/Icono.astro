---
/*
  SET DE ICONOS DE LA LANDING — una sola gramática para todos.

  Reglas que comparten (icons.md › Best practices: "Maintain visual consistency
  across all interface icons... consistent size, level of detail, stroke
  thickness, and perspective"):
    · rejilla 24×24            · trazo 1.5, redondeado
    · sin relleno              · hereda el color del texto (currentColor)
    · metáforas simplificadas  · nada decorativo dentro

  Van con aria-hidden porque en todos los casos acompañan a un título que ya
  dice lo mismo: anunciarlos otra vez sería ruido para un lector de pantalla.
  Si alguna vez se usa un icono SIN texto al lado, hay que pasarle `titulo`.
*/
interface Props {
  nombre:
    | "mecanismo" // lo construimos y lo operamos nosotros
    | "ajustes" // elegimos la herramienta según el caso
    | "llave" // te lo entregamos, eres dueño
    | "flujo" // operación y procesos
    | "capas" // tecnología y datos
    | "barras" // modelo de negocio
    | "libro" // capacitación
    | "check"; // viñeta de lista
  clase?: string;
  titulo?: string;
}
const { nombre, clase = "h-6 w-6", titulo } = Astro.props;

const trazos: Record<Props["nombre"], string> = {
  // Engranaje: el mecanismo que ya gira en nuestra propia operación.
  mecanismo:
    "M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.64 5.64l1.7 1.7M16.66 16.66l1.7 1.7M18.36 5.64l-1.7 1.7M7.34 16.66l-1.7 1.7",
  // Controles: no hay una sola herramienta, se ajusta a cada caso.
  ajustes: "M4 7.5h9M19 7.5h1M4 16.5h4M14 16.5h6",
  // Llave: al final la operación es tuya.
  llave: "M11.1 11.1 19.5 19.5M16.8 16.8l-2 2M19.5 19.5l-1.7 1.7",
  // Dos entradas que convergen en una salida: un proceso.
  flujo: "M7 6.9 16.9 11.3M7 17.1 16.9 12.7",
  // Capas apiladas: los datos y los sistemas por debajo.
  capas: "M12 3.2 20.5 7.4 12 11.6 3.5 7.4 12 3.2ZM3.5 12.1 12 16.3l8.5-4.2M3.5 16.3 12 20.5l8.5-4.2",
  // Barras ascendentes: el retorno se calcula antes de empezar.
  barras: "M4 20V4M4 20h16M8.5 20v-4.5M13.25 20v-8.5M18 20v-12.5",
  // Libro abierto: el equipo aprende a sostenerlo.
  // Palomeo de las listas. Antes vivía suelto en 3 componentes con otra
  // rejilla (20×20) y otro trazo (1.75): ahora comparte gramática.
  check: "M5 12.5l4.5 4.5 9.5-10.5",
  libro:
    "M4 5.6A1.6 1.6 0 0 1 5.6 4H11v16H5.6A1.6 1.6 0 0 1 4 18.4V5.6ZM20 5.6A1.6 1.6 0 0 0 18.4 4H13v16h5.4a1.6 1.6 0 0 0 1.6-1.6V5.6Z",
};

// Círculos que algunos iconos necesitan además del trazo.
const circulos: Partial<Record<Props["nombre"], { cx: number; cy: number; r: number }[]>> = {
  mecanismo: [{ cx: 12, cy: 12, r: 3.2 }],
  ajustes: [
    { cx: 16, cy: 7.5, r: 2.1 },
    { cx: 11, cy: 16.5, r: 2.1 },
  ],
  llave: [{ cx: 8.4, cy: 8.4, r: 3.9 }],
  flujo: [
    { cx: 5, cy: 6, r: 2 },
    { cx: 5, cy: 18, r: 2 },
    { cx: 19, cy: 12, r: 2 },
  ],
};
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={titulo ? "img" : undefined}
  aria-hidden={titulo ? undefined : "true"}
>
  {titulo && <title>{titulo}</title>}
  {circulos[nombre]?.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
  <path d={trazos[nombre]} />
</svg>
