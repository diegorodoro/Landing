---
import { producto } from "../config";
import Icono from "./Icono.astro";
import MockCotizador from "./MockCotizador.astro";
import MockAgente from "./MockAgente.astro";
import MockDashboard from "./MockDashboard.astro";
---

{/*
  PRODUCTOS, en tarjetas — primera sección después del hero.

  Va sobre fondo oscuro a propósito: los mockups son tarjetas blancas, así que
  resaltan contra el oscuro y no se pierden. La superficie de cada tarjeta es
  blanco al 5% (≈#272423), con el contraste verificado encima:
  blanco 15.41:1 · ink-300 6.11:1 · ink-100 12.27:1 — todos sobre el mínimo.

  Antes eran 3 bloques apilados a ancho completo alternando lados: mucho más
  alto. Las tarjetas dejan los tres productos comparables de un solo golpe.
*/}
<section id="producto" data-fondo-oscuro class="gradiente-oscuro flex min-h-svh items-center bg-brand-900 py-20 text-white sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium uppercase tracking-widest text-ink-300">Producto</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        {producto.titulo}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-300">{producto.bajada}</p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        producto.demos.map((demo, i) => (
          <li
            data-reveal
            style={`--d: ${i * 110}ms`}
            class="flex flex-col rounded-2xl border border-white/10 bg-white/5 p-5 transition-colors duration-300 hover:border-white/20 sm:p-6"
          >
            {/* El mockup arriba: es el argumento, no un adorno. */}
            <div class="[&>*]:shadow-none">
              {demo.tipo === "cotizador" && <MockCotizador />}
              {demo.tipo === "agente" && <MockAgente />}
              {demo.tipo === "dashboard" && <MockDashboard />}
            </div>

            <p class="mt-6 text-xs font-medium uppercase tracking-widest text-ink-300">
              {demo.etiqueta}
            </p>
            <h3 class="mt-2.5 text-xl font-semibold tracking-tight text-balance">{demo.titulo}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-ink-300">{demo.texto}</p>

            {/* El párrafo de arriba lleva flex-1, así absorbe el espacio
                sobrante y esta lista queda pegada al fondo: las 3 tarjetas
                alinean su franja inferior aunque los textos midan distinto. */}
            <ul class="mt-5 space-y-2.5 border-t border-white/10 pt-5 text-sm">
              {demo.puntos.map((punto) => (
                <li class="flex gap-2.5 text-ink-100">
                  <Icono nombre="check" clase="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
                  <span>{punto}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
