---
import { capacidades } from "../config";
---

<section id="capacidades" class="border-t border-ink-100 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium uppercase tracking-widest text-ink-500">Cómo cubrimos tu proyecto</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Cuatro disciplinas en cada proyecto, no un solo programador
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-500">
        Un proyecto que solo se mira desde lo técnico termina en una herramienta que nadie usa.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        capacidades.map((item, i) => (
          <li
            data-reveal
            style={`--d: ${i * 90}ms`}
            class="group relative overflow-hidden rounded-2xl border border-ink-100 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500/30 hover:shadow-xl hover:shadow-ink-900/5"
          >
            {/* Barrido de color al pasar el cursor */}
            <span
              class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              aria-hidden="true"
            />
            <h3 class="text-xl font-semibold tracking-tight">{item.titulo}</h3>
            <p class="mt-3 leading-relaxed text-ink-500">{item.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
