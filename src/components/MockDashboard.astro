---
/* Mockup 3: el dashboard. Barras que crecen y una línea que se dibuja sola.
   El SVG va inline: se anima con CSS y no cuesta una petición extra. */
const barras = [
  { mes: "Abr", alto: 38 },
  { mes: "May", alto: 52 },
  { mes: "Jun", alto: 45 },
  { mes: "Jul", alto: 68 },
  { mes: "Ago", alto: 81 },
  { mes: "Sep", alto: 96 },
];
---

<div class="rounded-xl border border-ink-100 bg-white p-5 shadow-sm" aria-hidden="true">
  <div class="flex items-start justify-between">
    <div>
      <p class="text-xs text-ink-500">Cotizaciones atendidas</p>
      <p class="mt-1 text-2xl font-semibold tabular-nums">1,284</p>
    </div>
    <span class="rounded-full bg-green-50 px-2.5 py-1 text-xs font-medium text-green-700">
      +38% vs. mes anterior
    </span>
  </div>

  <!-- Barras -->
  <div class="mt-6 flex h-28 items-end gap-2.5">
    {
      barras.map((barra, i) => (
        <div class="flex flex-1 flex-col items-center gap-2">
          <div class="flex h-full w-full items-end">
            <div
              class="barra w-full origin-bottom rounded-t-md bg-gradient-to-t from-brand-500 to-brand-500/60"
              style={`height: ${barra.alto}%; --d: ${0.2 + i * 0.1}s`}
            />
          </div>
          <span class="text-[10px] text-ink-300">{barra.mes}</span>
        </div>
      ))
    }
  </div>

  <!-- Línea de tendencia -->
  <div class="mt-5 border-t border-ink-100 pt-4">
    <p class="text-xs text-ink-500">Tiempo medio de respuesta</p>
    <svg class="mt-2 h-12 w-full" viewBox="0 0 200 40" fill="none" preserveAspectRatio="none">
      <path
        class="linea"
        d="M0 6 L33 12 L66 10 L100 20 L133 26 L166 31 L200 35"
        stroke="var(--color-brand-500)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <div class="flex items-baseline justify-between">
      <span class="text-xs text-ink-300">hace 6 meses</span>
      <span class="text-xs font-medium text-green-600">de 41 h a 3 min</span>
    </div>
  </div>
</div>

<style>
  @keyframes barra-crece {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .barra {
    animation: barra-crece 0.8s var(--ease-out-soft) backwards;
    animation-delay: var(--d, 0s);
  }

  /* La línea se dibuja recortando el trazo discontinuo. */
  @keyframes traza {
    to {
      stroke-dashoffset: 0;
    }
  }
  .linea {
    stroke-dasharray: 230;
    stroke-dashoffset: 230;
    animation: traza 1.6s var(--ease-out-soft) 0.5s forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .barra {
      animation: none;
    }
    .linea {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
