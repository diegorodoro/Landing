---
import { paraQuien } from "../config";
import Icono from "./Icono.astro";
---

<section id="para-quien" class="flex min-h-svh items-center py-20 sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium uppercase tracking-widest text-ink-500">Para quién</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Si te reconoces en esta lista, tenemos de qué hablar
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-500">
        Trabajamos con empresas donde la operación todavía depende de personas haciendo tareas
        repetitivas a mano.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {
        paraQuien.map((grupo, i) => (
          <div
            data-reveal
            style={`--d: ${i * 120}ms`}
            class="rounded-2xl border border-ink-100 bg-ink-50/60 p-8 transition-colors duration-300 hover:border-brand-500/30"
          >
            <h3 class="text-2xl font-semibold tracking-tight">{grupo.titulo}</h3>
            <p class="mt-2 text-sm text-ink-500">{grupo.perfil}</p>

            <ul class="mt-7 space-y-3.5">
              {grupo.senales.map((senal) => (
                <li class="flex gap-3 leading-relaxed text-ink-700">
                  <Icono nombre="check" clase="mt-1 h-5 w-5 shrink-0 text-acento" />
                  <span>{senal}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
