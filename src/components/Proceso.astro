---
import { proceso } from "../config";
---

<section id="proceso" class="flex min-h-svh items-center bg-ink-50 py-20 sm:py-24">
  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="max-w-2xl" data-reveal>
      <p class="text-sm font-medium uppercase tracking-widest text-ink-500">Cómo trabajamos</p>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
        Del primer contacto a tu equipo operándolo solo
      </h2>
    </div>

    <ol class="relative mt-14 max-w-3xl">
      <!-- Línea vertical que conecta los pasos -->
      <div
        class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-ink-900 via-ink-300 to-ink-100"
        data-draw
        aria-hidden="true"
      >
      </div>

      {
        proceso.map((paso, i) => (
          <li class="relative flex gap-6 pb-10 last:pb-0" data-reveal style={`--d: ${i * 90}ms`}>
            <span class="relative z-10 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-900 text-sm font-semibold tabular-nums text-white">
              {i + 1}
            </span>
            <div class="pt-0.5">
              <h3 class="text-lg font-semibold tracking-tight">{paso.titulo}</h3>
              <p class="mt-1.5 leading-relaxed text-ink-500">{paso.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Dibuja la línea del proceso cuando la lista entra en pantalla. El trazo
  // avanza en el mismo sentido en que se leen los pasos, así el movimiento
  // dice algo sobre el contenido en lugar de adornarlo.
  const linea = document.querySelector<HTMLElement>("[data-draw]");
  const quieto = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (linea && !quieto && "IntersectionObserver" in window) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          entrada.target.classList.add("is-drawn");
          observador.unobserve(entrada.target);
        }
      },
      { threshold: 0.1 },
    );
    observador.observe(linea);
  } else if (linea) {
    linea.classList.add("is-drawn");
  }
</script>
