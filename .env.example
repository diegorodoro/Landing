# Copia este archivo como .env para probar en local.
#
# true  → la página principal muestra la pantalla "Próximamente"
# false → (o sin definir) se muestra la landing completa
#
# En producción, define esta variable en el panel de tu hosting
# (Vercel, Netlify, Cloudflare Pages…) solo para la rama main.
PUBLIC_PROXIMAMENTE=false
